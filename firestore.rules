rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper Primitives
    function isSignedIn() {
      return true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // Schema validations
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'email', 'avatar'])
        && data.keys().size() >= 5
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.role is string && (data.role == 'guru' || data.role == 'siswa' || data.role == 'orangtua')
        && data.email is string && data.email.size() <= 150
        && data.avatar is string && data.avatar.size() <= 200;
    }
    
    function isValidClass(data) {
      return data.keys().hasAll(['id', 'name', 'subject', 'teacherId'])
        && data.keys().size() == 4
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.subject is string && data.subject.size() <= 100
        && data.teacherId is string && data.teacherId.size() <= 128;
    }
    
    function isValidTask(data) {
      return data.keys().hasAll(['id', 'classId', 'className', 'title', 'description', 'dueDate', 'maxScore', 'createdAt'])
        && data.keys().size() == 8
        && data.id is string && data.id.size() <= 128
        && data.classId is string && data.classId.size() <= 128
        && data.className is string && data.className.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.dueDate is string && data.dueDate.size() <= 100
        && data.maxScore is number
        && data.createdAt is string && data.createdAt.size() <= 100;
    }
    
    function isValidSubmission(data) {
      return data.keys().hasAll(['id', 'taskId', 'taskTitle', 'studentId', 'studentName', 'submittedAt', 'content', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.taskId is string && data.taskId.size() <= 128
        && data.taskTitle is string && data.taskTitle.size() <= 200
        && data.studentId is string && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() <= 100
        && data.submittedAt is string && data.submittedAt.size() <= 100
        && data.content is string && data.content.size() <= 5000
        && data.status is string && (data.status == 'submitted' || data.status == 'graded');
    }
    
    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'date', 'classId', 'className', 'studentId', 'studentName', 'status'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.date is string && data.date.size() == 10
        && data.classId is string && data.classId.size() <= 128
        && data.className is string && data.className.size() <= 100
        && data.studentId is string && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() <= 100
        && data.status is string && (data.status == 'hadir' || data.status == 'izin' || data.status == 'sakit' || data.status == 'alfa');
    }
    
    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'message', 'createdAt', 'isRead', 'type'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.message is string && data.message.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 100
        && data.isRead is bool
        && data.type is string && (data.type == 'task' || data.type == 'grade' || data.type == 'attendance' || data.type == 'announcement');
    }
    
    // User Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isSignedIn();
    }
    
    // Class Rules
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(classId) && isValidClass(request.resource.data);
      allow delete: if isSignedIn();
    }
    
    // Task Rules
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(taskId) && isValidTask(request.resource.data);
      allow delete: if isSignedIn();
    }
    
    // Submission Rules
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(submissionId) && isValidSubmission(request.resource.data);
      allow delete: if isSignedIn();
    }
    
    // Attendance Rules
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(request.resource.data);
      allow delete: if isSignedIn();
    }
    
    // Notification Rules
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(notificationId) && isValidNotification(request.resource.data);
      allow delete: if isSignedIn();
    }
  }
}
